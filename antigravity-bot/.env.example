BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_USER_IDS=123456789
# Secure AGY worker. Keep the CLI runtime outside /root and outside the bot source.
AGY_PATH=/opt/antigravity-bot/agy-worker-runtime/bin/agy
# Used only by the explicit AGY_ALLOW_UNSANDBOXED_DEV=true fallback.
AGY_MCP_CONFIG_PATH=~/.gemini/config/mcp_config.json
AGY_SANDBOX_BINARY=/usr/bin/bwrap
AGY_SANDBOX_PYTHON_PATH=/usr/bin/python3
AGY_WORKER_HOME=/opt/antigravity-bot/agy-worker-home
AGY_WORKER_RUNTIME_DIR=/opt/antigravity-bot/agy-worker-runtime
# Set these to the dedicated non-root agyworker account created during deployment.
AGY_WORKER_UID=65534
AGY_WORKER_GID=65534
AGY_CAPABILITY_SOCKET_DIR=/tmp/antigravity-capabilities
# Emergency local debugging only. Keep false on the VPS.
AGY_ALLOW_UNSANDBOXED_DEV=false
WHISPER_MODEL=small
WORKSPACES_DIR=/tmp/workspaces
TASK_WORKSPACES_DIR=/tmp/antigravity-task-workspaces
TASK_ARTIFACTS_DIR=/tmp/antigravity-task-artifacts
# Per-task output delivery limits. Files that exceed a limit stay on the VPS.
ARTIFACT_MAX_FILES=20
ARTIFACT_MAX_SIZE_MB=45
DB_PATH=/opt/antigravity-bot/data/bot.db
SSH_KEY_PATH=/opt/antigravity-bot/.ssh/bot_ed25519
SSH_KNOWN_HOSTS_PATH=/opt/antigravity-bot/.ssh/known_hosts
SSH_COMMAND_TIMEOUT_SECONDS=120
SSH_APPROVAL_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
FORUM_GROUP_ID=-1000000000000
